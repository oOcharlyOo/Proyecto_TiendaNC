<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sombra oscura compacta -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/shadow_dark" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Borde madera/bronce -->
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/zelda_wood" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <!-- Relleno verde panel -->
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/zelda_panel_bg" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
