<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:bottom="3dp"
        android:left="2dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#c75a5a"
                android:centerColor="#a84747"
                android:endColor="#7a2f2f" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
