<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC060d09">

    <LinearLayout
        android:layout_width="440dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/zelda_panel"
        android:padding="@dimen/space_xl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Categorias y Subcategorias"
            android:textColor="@color/gold_light"
            android:textSize="@dimen/text_xl"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="@dimen/space_sm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Categorias"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_sm" />

            <TextView
                android:id="@+id/btnNuevaCategoria"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_small"
                android:background="@drawable/zelda_selector"
                android:gravity="center"
                android:paddingHorizontal="@dimen/space_md"
                android:text="+ Cat"
                android:textColor="@color/gold_light"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategorias"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="@dimen/space_xs"
            android:background="@drawable/zelda_panel_active"
            android:padding="@dimen/space_xs" />

        <TextView
            android:id="@+id/tvSubTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="Subcategorias"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_sm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_xs">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnNuevaSubcategoria"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target_small"
                android:background="@drawable/zelda_selector"
                android:gravity="center"
                android:paddingHorizontal="@dimen/space_md"
                android:text="+ Sub"
                android:textColor="@color/gold_light"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSubcategorias"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="@dimen/space_xs"
            android:background="@drawable/zelda_panel_active"
            android:padding="@dimen/space_xs" />

        <TextView
            android:id="@+id/btnCerrar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_large"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/zelda_btn_cancel"
            android:gravity="center"
            android:text="Cerrar"
            android:textColor="@color/white"
            android:textSize="@dimen/text_lg"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
