<?xml version="1.0" encoding="utf-8"?><androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"    xmlns:app="http://schemas.android.com/apk/res-auto"    android:layout_width="match_parent"    android:layout_height="match_parent"    android:background="@color/bg_main"    android:padding="@dimen/padding_screen">    <TextView        android:id="@+id/tvTitle"        android:layout_width="0dp"        android:layout_height="wrap_content"        android:text="💰 Finanzas"        android:textColor="@color/gold_light"        android:textSize="@dimen/text_title"        android:textStyle="bold"        app:layout_constraintEnd_toEndOf="parent"        app:layout_constraintStart_toStartOf="parent"        app:layout_constraintTop_toTopOf="parent" />    <androidx.cardview.widget.CardView        android:id="@+id/cardBoveda"        android:layout_width="0dp"        android:layout_height="@dimen/card_height_xxl"        android:layout_marginTop="@dimen/space_lg"        android:background="@drawable/zelda_panel"        app:cardBackgroundColor="@android:color/transparent"        app:cardCornerRadius="@dimen/corner_xl"        app:cardElevation="0dp"        app:layout_constraintEnd_toEndOf="parent"        app:layout_constraintStart_toStartOf="parent"        app:layout_constraintTop_toBottomOf="@id/tvTitle">        <LinearLayout            android:layout_width="match_parent"            android:layout_height="match_parent"            android:gravity="center"            android:orientation="vertical">            <TextView                android:layout_width="wrap_content"                android:layout_height="wrap_content"                android:text="🏦 Bóveda"                android:textColor="@color/white"                android:textSize="@dimen/text_body" />            <TextView                android:id="@+id/tvSaldo"                android:layout_width="wrap_content"                android:layout_height="wrap_content"                android:layout_marginTop="@dimen/space_xs"                android:text="$0.00"                android:textColor="@color/gold_light"                android:textSize="@dimen/text_display_xl"                android:textStyle="bold" />        </LinearLayout>    </androidx.cardview.widget.CardView>    <LinearLayout        android:layout_width="0dp"        android:layout_height="wrap_content"        android:layout_marginTop="@dimen/space_lg"        android:orientation="horizontal"        app:layout_constraintEnd_toEndOf="parent"        app:layout_constraintStart_toStartOf="parent"        app:layout_constraintTop_toBottomOf="@id/cardBoveda">        <androidx.cardview.widget.CardView            android:id="@+id/btnEntrada"            android:layout_width="0dp"            android:layout_height="@dimen/touch_target_large"            android:layout_marginEnd="@dimen/space_sm"            android:layout_weight="1"            android:background="@drawable/zelda_selector"            android:clickable="true"            android:focusable="true"            app:cardBackgroundColor="@android:color/transparent"            app:cardCornerRadius="@dimen/corner_md"            app:cardElevation="0dp">            <TextView                android:layout_width="match_parent"                android:layout_height="match_parent"                android:gravity="center"                android:text="➕ Entrada"                android:textColor="@color/success"                android:textSize="@dimen/text_body"                android:textStyle="bold" />        </androidx.cardview.widget.CardView>        <androidx.cardview.widget.CardView            android:id="@+id/btnSalida"            android:layout_width="0dp"            android:layout_height="@dimen/touch_target_large"            android:layout_marginStart="@dimen/space_sm"            android:layout_weight="1"            android:background="@drawable/zelda_selector"            android:clickable="true"            android:focusable="true"            app:cardBackgroundColor="@android:color/transparent"            app:cardCornerRadius="@dimen/corner_md"            app:cardElevation="0dp">            <TextView                android:layout_width="match_parent"                android:layout_height="match_parent"                android:gravity="center"                android:text="➖ Salida"                android:textColor="@color/danger"                android:textSize="@dimen/text_body"                android:textStyle="bold" />        </androidx.cardview.widget.CardView>    </LinearLayout>    <TextView        android:id="@+id/tvMovimientosTitle"        android:layout_width="0dp"        android:layout_height="wrap_content"        android:layout_marginTop="@dimen/space_lg"        android:text="Movimientos Recientes"        android:textColor="@color/white"        android:textSize="@dimen/text_lg"        android:textStyle="bold"        app:layout_constraintEnd_toEndOf="parent"        app:layout_constraintStart_toStartOf="parent"        app:layout_constraintTop_toBottomOf="@+id/btnEntrada" />    <androidx.recyclerview.widget.RecyclerView        android:id="@+id/rvMovimientos"        android:layout_width="0dp"        android:layout_height="0dp"        android:layout_marginTop="@dimen/space_sm"        app:layout_constraintBottom_toBottomOf="parent"        app:layout_constraintEnd_toEndOf="parent"        app:layout_constraintStart_toStartOf="parent"        app:layout_constraintTop_toBottomOf="@+id/tvMovimientosTitle" /></androidx.constraintlayout.widget.ConstraintLayout>