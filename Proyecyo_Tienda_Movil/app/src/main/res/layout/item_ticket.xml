<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/space_xxs"
    android:background="@drawable/zelda_panel_active"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="@dimen/corner_sm"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_xs">

        <TextView
            android:id="@+id/tvCantidad"
            android:layout_width="@dimen/ticket_qty_width"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/gold_light"
            android:textSize="@dimen/text_sm"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xxs"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/white"
            android:textSize="@dimen/text_xs" />

        <TextView
            android:id="@+id/tvSubtotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xxs"
            android:textColor="@color/gold_light"
            android:textSize="@dimen/text_xs"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/btnEliminar"
            android:layout_width="@dimen/touch_target_small"
            android:layout_height="@dimen/touch_target_small"
            android:layout_marginStart="@dimen/space_xxs"
            android:gravity="center"
            android:text="🗑"
            android:textColor="@color/danger"
            android:textSize="@dimen/text_sm"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
