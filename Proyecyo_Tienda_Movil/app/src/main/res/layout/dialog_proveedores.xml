<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC060d09">

    <LinearLayout
        android:layout_width="440dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/zelda_panel"
        android:padding="@dimen/space_xl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚚 Proveedores y Pedidos"
            android:textColor="@color/gold_light"
            android:textSize="@dimen/text_xl"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="@dimen/space_md" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/space_xs">

            <TextView
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/space_xs"
                android:background="@drawable/zelda_selector"
                android:gravity="center"
                android:text="Nuevo proveedor"
                android:textColor="@color/gold_light"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                android:id="@+id/btnNuevoProveedor" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target"
                android:layout_weight="1"
                android:background="@drawable/zelda_selector"
                android:gravity="center"
                android:text="Nuevo pedido"
                android:textColor="@color/gold_light"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                android:id="@+id/btnNuevoPedido" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Proveedores"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_sm"
            android:layout_marginBottom="@dimen/space_xs" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProveedores"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:clipToPadding="false"
            android:padding="@dimen/space_xs" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gold_dark"
            android:layout_marginVertical="@dimen/space_sm" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pedidos"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_sm"
            android:layout_marginBottom="@dimen/space_xs" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPedidos"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:clipToPadding="false"
            android:padding="@dimen/space_xs" />

        <TextView
            android:id="@+id/btnProvision"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/zelda_btn_confirm"
            android:gravity="center"
            android:text="Ver provision semanal"
            android:textColor="@color/white"
            android:textSize="@dimen/text_lg"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            android:gravity="center"
            android:layout_marginTop="@dimen/space_sm" />

        <TextView
            android:id="@+id/btnCerrar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target_large"
            android:layout_marginTop="@dimen/space_lg"
            android:background="@drawable/zelda_btn_cancel"
            android:gravity="center"
            android:text="Cerrar"
            android:textColor="@color/white"
            android:textSize="@dimen/text_lg"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
