<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Main Content (mobile single-column, web <=991px style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/space_md">

        <!-- Top Bar: Menu + Search + Barcode + Historial -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/card_height_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/zelda_panel"
            android:paddingHorizontal="@dimen/space_lg"
            android:layout_marginBottom="@dimen/space_sm">

            <TextView
                android:id="@+id/btnMenu"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:gravity="center"
                android:text="☰"
                android:textColor="@color/gold_light"
                android:textSize="@dimen/icon_lg"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:layout_width="@dimen/icon_lg"
                android:layout_height="@dimen/icon_lg"
                android:layout_marginStart="@dimen/space_sm"
                android:src="@android:drawable/ic_menu_search"
                android:contentDescription="Buscar" />

            <EditText
                android:id="@+id/etBuscar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Buscar producto o código..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingHorizontal="@dimen/space_sm"
                android:textColor="@color/white"
                android:textColorHint="@color/text_secondary"
                android:textSize="@dimen/text_body" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cardBarcode"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:layout_marginStart="@dimen/space_sm"
                android:background="@drawable/zelda_selector"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/corner_md"
                app:cardElevation="0dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="📷"
                    android:textSize="@dimen/icon_md" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnHistorial"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:layout_marginStart="@dimen/space_xs"
                android:background="@drawable/zelda_selector"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/corner_md"
                app:cardElevation="0dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="📜"
                    android:textSize="@dimen/icon_md" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Categorias -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCategorias"
            android:layout_width="match_parent"
            android:layout_height="@dimen/card_height_sm"
            android:layout_marginTop="@dimen/space_sm"
            android:orientation="horizontal"
            android:clipToPadding="false" />

        <!-- Products -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProductos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/space_sm"
            android:clipToPadding="false"
            android:padding="@dimen/space_xs" />

        <!-- Cart Panel (bottom bar that expands/collapses) -->
        <LinearLayout
            android:id="@+id/bottomBarContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="220dp"
            android:orientation="vertical"
            android:background="@drawable/zelda_panel"
            android:padding="@dimen/space_md"
            android:layout_marginTop="@dimen/space_sm">

            <LinearLayout
                android:id="@+id/cartHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/space_sm">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ticket"
                    android:textColor="@color/gold_light"
                    android:textSize="@dimen/text_lg"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTicketInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#1"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_md"
                    android:layout_marginEnd="@dimen/space_sm" />

                <TextView
                    android:id="@+id/cartBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/zelda_panel_active"
                    android:textColor="@color/gold_light"
                    android:textSize="@dimen/text_xs"
                    android:paddingHorizontal="@dimen/space_sm"
                    android:paddingVertical="@dimen/space_xxs" />

                <TextView
                    android:id="@+id/btnTickets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:background="@drawable/zelda_selector"
                    android:gravity="center"
                    android:text="🎫"
                    android:textColor="@color/gold_light"
                    android:textSize="@dimen/text_md"
                    android:paddingHorizontal="@dimen/space_sm"
                    android:paddingVertical="@dimen/space_xxs"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/btnClear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_sm"
                    android:text="🗑"
                    android:textColor="@color/danger"
                    android:textSize="@dimen/text_md"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Collapsible ticket rail (web mobile: toggle-ticket-mobile) -->
            <LinearLayout
                android:id="@+id/ticketRailContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/space_xs">

                        <TextView
                            android:id="@+id/btnNuevoTicket"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_xs"
                            android:background="@drawable/zelda_selector"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/space_md"
                            android:paddingVertical="@dimen/space_sm"
                            android:text="🎫"
                            android:textColor="@color/gold_light"
                            android:textSize="@dimen/text_md"
                            android:visibility="gone" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvTickets"
                            android:layout_width="wrap_content"
                            android:layout_height="54dp"
                            android:layout_marginBottom="@dimen/space_sm"
                            android:clipToPadding="false"
                            android:orientation="horizontal" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <View
                android:id="@+id/cartDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/zelda_wood"
                android:layout_marginBottom="@dimen/space_sm" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCartItems"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/space_sm" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/zelda_panel_active"
                android:padding="@dimen/space_md">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total"
                    android:textColor="@color/gold_light"
                    android:textSize="@dimen/text_sm"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTicketTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textColor="@color/success"
                    android:textSize="@dimen/text_lg"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnCobrarCart"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_target_large"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/zelda_btn_confirm"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="@dimen/corner_md"
                app:cardElevation="0dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="💰 Cobrar"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_lg"
                    android:textStyle="bold" />
            </androidx.cardview.widget.CardView>

            <HorizontalScrollView
                android:id="@+id/cartActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnEntrada"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_target_small"
                        android:layout_marginEnd="@dimen/space_xxs"
                        android:background="@drawable/zelda_selector"
                        android:gravity="center"
                        android:text="⬆ Efectivo"
                        android:textColor="@color/gold_light"
                        android:textSize="@dimen/text_xs"
                        android:paddingHorizontal="@dimen/space_sm"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnSalida"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_target_small"
                        android:layout_marginEnd="@dimen/space_xxs"
                        android:background="@drawable/zelda_selector"
                        android:gravity="center"
                        android:text="⬇ Efectivo"
                        android:textColor="@color/gold_light"
                        android:textSize="@dimen/text_xs"
                        android:paddingHorizontal="@dimen/space_sm"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnPendientes"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_target_small"
                        android:layout_marginEnd="@dimen/space_xxs"
                        android:background="@drawable/zelda_selector"
                        android:gravity="center"
                        android:text="⏳ Pendientes"
                        android:textColor="@color/gold_light"
                        android:textSize="@dimen/text_xs"
                        android:paddingHorizontal="@dimen/space_sm"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnCreditos"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_target_small"
                        android:layout_marginEnd="@dimen/space_xxs"
                        android:background="@drawable/zelda_selector"
                        android:gravity="center"
                        android:text="💳 Créditos"
                        android:textColor="@color/gold_light"
                        android:textSize="@dimen/text_xs"
                        android:paddingHorizontal="@dimen/space_sm"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnPromociones"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_target_small"
                        android:layout_marginEnd="@dimen/space_xxs"
                        android:background="@drawable/zelda_selector"
                        android:gravity="center"
                        android:text="🏷 Promociones"
                        android:textColor="@color/gold_light"
                        android:textSize="@dimen/text_xs"
                        android:paddingHorizontal="@dimen/space_sm"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnProveedores"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/touch_target_small"
                        android:background="@drawable/zelda_selector"
                        android:gravity="center"
                        android:text="🚚 Proveedores"
                        android:textColor="@color/gold_light"
                        android:textSize="@dimen/text_xs"
                        android:paddingHorizontal="@dimen/space_sm"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>

    <!-- Drawer Navigation -->
    <LinearLayout
        android:layout_width="@dimen/drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/zelda_panel"
        android:orientation="vertical"
        android:padding="@dimen/space_xl"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_lg"
            android:text="⚔️ Módulos"
            android:textColor="@color/gold_light"
            android:textSize="@dimen/text_xl"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/navVentas"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginBottom="@dimen/space_xs"
            android:background="@drawable/zelda_panel_active"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_lg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🛒 Ventas"
                android:textColor="@color/gold_light"
                android:textSize="@dimen/text_lg" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProductos"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginBottom="@dimen/space_xs"
            android:background="@drawable/zelda_selector"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_lg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📦 Productos"
                android:textColor="@color/white"
                android:textSize="@dimen/text_lg" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navUsuarios"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginBottom="@dimen/space_xs"
            android:background="@drawable/zelda_selector"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_lg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👥 Usuarios"
                android:textColor="@color/white"
                android:textSize="@dimen/text_lg" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCorte"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginBottom="@dimen/space_xs"
            android:background="@drawable/zelda_selector"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_lg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📊 Corte"
                android:textColor="@color/white"
                android:textSize="@dimen/text_lg" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navFinanzas"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginBottom="@dimen/space_xs"
            android:background="@drawable/zelda_selector"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_lg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💰 Finanzas"
                android:textColor="@color/white"
                android:textSize="@dimen/text_lg" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navRental"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginBottom="@dimen/space_xs"
            android:background="@drawable/zelda_selector"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_lg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎮 Rental"
                android:textColor="@color/white"
                android:textSize="@dimen/text_lg" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navInventario"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginBottom="@dimen/space_xs"
            android:background="@drawable/zelda_selector"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_lg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📋 Inventario"
                android:textColor="@color/white"
                android:textSize="@dimen/text_lg" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navApartados"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:layout_marginBottom="@dimen/space_xs"
            android:background="@drawable/zelda_selector"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_lg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📦 Apartados"
                android:textColor="@color/white"
                android:textSize="@dimen/text_lg" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navHistorial"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/zelda_selector"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_lg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📜 Historial"
                android:textColor="@color/white"
                android:textSize="@dimen/text_lg" />
        </LinearLayout>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
