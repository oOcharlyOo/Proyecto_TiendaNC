vity="center"                    android:clickable="true"                    android:focusable="true">                    <TextView                        android:layout_width="wrap_content"                        android:layout_height="wrap_content"                        android:text="📱"                        android:textSize="@dimen/icon_lg" />                    <TextView                        android:layout_width="wrap_content"                        android:layout_height="wrap_content"                        android:text="Transf."                        android:textSize="@dimen/text_xs"                        android:textStyle="bold"                        android:textColor="@color/white"                        android:layout_marginTop="@dimen/space_xxs"                        android:maxLines="1"                        android:ellipsize="end"/>                </LinearLayout>            </LinearLayout>            <!-- Métodos de Pago (fila 2) -->            <LinearLayout                android:layout_width="match_parent"                android:layout_height="wrap_content"                android:layout_marginTop="@dimen/space_xs"                android:orientation="horizontal">                <LinearLayout                    android:id="@+id/btnPendiente"                    android:layout_width="0dp"                    android:layout_height="@dimen/touch_target_large"                    android:layout_weight="1"                    android:layout_marginEnd="@dimen/space_xs"                    android:background="@drawable/zelda_selector"                    android:orientation="vertical"                    android:gravity="center"                    android:clickable="true"                    android:focusable="true">                    <TextView                        android:layout_width="wrap_content"                        android:layout_height="wrap_content"                        android:text="⏳"                        android:textSize="@dimen/icon_lg" />