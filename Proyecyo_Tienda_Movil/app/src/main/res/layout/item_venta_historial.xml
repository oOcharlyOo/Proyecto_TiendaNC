<?xml version="1.0" encoding="utf-8"?><androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"    xmlns:app="http://schemas.android.com/apk/res-auto"    android:layout_width="match_parent"    android:layout_height="wrap_content"    android:layout_marginVertical="@dimen/space_xs"    android:background="@drawable/zelda_panel"    app:cardBackgroundColor="@android:color/transparent"    app:cardCornerRadius="@dimen/corner_md"    app:cardElevation="0dp">    <LinearLayout        android:layout_width="match_parent"        android:layout_height="wrap_content"        android:orientation="horizontal"        android:padding="@dimen/space_md"        android:gravity="center_vertical">        <LinearLayout            android:layout_width="0dp"            android:layout_height="wrap_content"            android:layout_weight="1"            android:orientation="vertical">            <TextView                android:id="@+id/tvFecha"                android:layout_width="wrap_content"                android:layout_height="wrap_content"                android:textColor="@color/white"                android:textSize="@dimen/text_sm"                android:textStyle="bold" />            <LinearLayout                android:layout_width="wrap_content"                android:layout_height="wrap_content"                android:orientation="horizontal"                android:layout_marginTop="@dimen/space_xxs"                android:gravity="center_vertical">                <TextView                    android:id="@+id/tvMetodo"                    android:layout_width="wrap_content"                    android:layout_height="wrap_content"                    android:textColor="@color/white"                    android:textSize="@dimen/text_xs" />                <TextView                    android:id="@+id/tvEstado"                    android:layout_width="wrap_content"                    android:layout_height="wrap_content"                    android:layout_marginStart="@dimen/space_sm"                    android:paddingHorizontal="@dimen/space_sm"                    android:paddingVertical="@dimen/space_xxs"                    android:textSize="@dimen/text_xxs"                    android:textStyle="bold" />            </LinearLayout>        </LinearLayout>        <LinearLayout            android:layout_width="wrap_content"            android:layout_height="wrap_content"            android:orientation="vertical"            android:gravity="end">            <TextView                android:id="@+id/tvTotal"                android:layout_width="wrap_content"                android:layout_height="wrap_content"                android:textColor="@color/gold_light"                android:textSize="@dimen/text_lg"                android:textStyle="bold" />            <TextView                android:id="@+id/tvSync"                android:layout_width="wrap_content"                android:layout_height="wrap_content"                android:layout_marginTop="@dimen/space_xxs"                android:textSize="@dimen/text_xxs"                android:textStyle="bold" />            <Button                android:id="@+id/btnCancelar"                android:layout_width="wrap_content"                android:layout_height="@dimen/touch_target"                android:layout_marginTop="@dimen/space_xxs"                android:background="@drawable/zelda_selector"                android:text="❌ Cancelar"                android:textColor="@color/gold_light"                android:textStyle="bold"                android:textSize="@dimen/text_xs"                android:stateListAnimator="@null"                android:visibility="gone" />        </LinearLayout>    </LinearLayout></androidx.cardview.widget.CardView>